d.faq.answer2":"<a {{0}}>Google instructions for getting your Organization ID</a>.","about.appsForSchools.android.faq.answer3":"Yes! Google has been adding Android app support for a wide range of Chromebooks since 2016. This capability allows our app to run seamlessly on both Chromebooks and Android devices.","about.appsForSchools.android.faq.answer4":"We’ll add a new license request link to this page at the beginning of each calendar year to support schools licensing the app for the following academic year. At that time you can adjust the number of licenses.","about.appsForSchools.android.faq.answer5":"<a {{0}}>Chrome OS Systems Supporting Android Apps</a>","about.appsForSchools.android.faq.answer6":"No personally identifiable information is collected by PhET. The PhET Simulations Android app is meant to provide educational simulations to a wide audience. As we strive to collect the minimum amount of information needed to advance our educational mission, we have determined that there is no need for the collection of personal data within this app. <a {{0}}>Read the full privacy policy</a>.","about.appsForSchools.android.faq.answer7":"Both versions of our Chromebook app will match the <a {{0}}>language setting of the device</a>. The app is supported in the following languages:<br/><br/>{{2}}<br/><br/>Setting the device to an unsupported language will display <a {{1}}>translated simulations</a> in that language, but the app will fallback to the most similar language available.","about.appsForSchools.android.faq.question1":"How do I approve and distribute the app to school Chromebooks?","about.appsForSchools.android.faq.question2":"How do I find my Organization ID?","about.appsForSchools.android.faq.question3":"I can deploy this Android app to school Chromebooks?","about.appsForSchools.android.faq.question4":"What happens next school year?","about.appsForSchools.android.faq.question5":"What devices are compatible?","about.appsForSchools.android.faq.question6":"Is student data collected from the app?","about.appsForSchools.android.faq.question7":"What languages are supported?","about.appsForSchools.chromebookCompatibility":"To be compatible with the PhET app, <a {{0}}>school Chromebooks must support Android apps</a>.","about.appsForSchools.chromebookCost":"$0.99 USD per annual license","about.appsForSchools.chromebookDeployment":"To deploy the app, PhET will publish a private version to your Google organization. Your school will continue to have full control over how the PhET app is deployed through the Google Admin Console.","about.appsForSchools.downloadIndividualApp":"Download the PhET app today!","about.appsForSchools.faq.title":"FAQ","about.appsForSchools.features.favorites":"Saves favorites","about.appsForSchools.features.filters":"Filters by subject and grade","about.appsForSchools.features.offline":"Runs offline","about.appsForSchools.features.translated":"Translated","about.appsForSchools.features.updates":"Adds new sims automatically","about.appsForSchools.individualUser":"Individual user?","about.appsForSchools.ios.title":"iPads","about.appsForSchools.ios.faq.answer1":"Apple School Manager and your mobile device management (MDM) solution work together so your organization can buy content in volume, assign them to devices or users, and then install and update them wirelessly, even if the App Store is disabled. <a {{0}}>License Management Instructions</a>","about.appsForSchools.ios.faq.answer2":"The PhET iOS app automatically matches the <a {{0}}>language preference setting of your iPad or iPhone</a>. The app is supported in the following languages:<br/><br/>{{2}}<br/><br/>Setting the device to an unsupported language will display <a {{1}}>translated simulations</a> in that language, but the app will fallback to the most similar language available.","about.appsForSchools.ios.faq.question1":"How do I distribute the app to school iPads?","about.appsForSchools.ios.faq.question2":"What languages are supported?","about.appsForSchools.iosCost":"$0.99 USD per lifetime license","about.appsForSchools.iosVolumePurchase":"Purchase directly through the <a {{0}}>Apple School Manager</a> or <a {{1}}>Apple Business Manager</a>","about.appsForSchools.iosVppDescription":"Licenses are purchased through Apple School or Business Manager and are retained by the school's organizational account. Apps can be revoked and reassigned to different iOS devices and users, so your organization retains full ownership and control of purchased apps.","about.appsForSchools.licenseRequest":"License Request","about.appsForSchools.quote1":"It can be tricky as an educator to find high quality, hands-on, and interactive science and math resources for students that are also really easy to implement in the classroom... I am so grateful that there is now an app that makes PhET sims even more accessible and available.","about.appsForSchools.quote2":"PhET in different languages! The best app for science and math education out there! Love that all the translations are now available on the app!","about.appsForSchools.quote3":"I have taught Physics with PhET for years - their simulations make concepts clear. Now students and anyone interested can explore them in a neat app environment … The package will capture students' imagination and they'll investigate more topics than they came for!","about.appsForSchools.schoolPurchases":"School Purchases","about.appsForSchools.title":"Apps for Schools","about.appsForSchools.usOnly":"PhET for Schools is currently only available to schools in the US"}}},"cookie-policy":{"CookiePolicyPage.tsx":function(e,t,n){let i,o,a,r,s,l,c,u;n.export({CookiePolicyPage:()=>_},!0),n.link("react",{default(e){i=e}},0),n.link("../../../../api/strings/strings",{Strings(e){o=e}},1),n.link("../../../../api/urlUtils.js",{getInlineExternalHref(e){a=e}},2),n.link("../../../components/banner/Banner",{Banner(e){r=e},BannerModel(e){s=e}},3),n.link("../../../components/phetTable/PhetTable",{PhetTable(e){l=e}},4),n.link(