get.className.includes('rsActiveSlide')\n                    ) {\n                        debug && console.log('[Gallery] Slide:', { slideIndex, skipBecauseOfAdSlide });\n                        if (!skipBecauseOfAdSlide && slideIndex % refreshEveryXSlides === 0) {\n                            const placements = getGalleryPlacements(overlayContainer);\n                            if (placements.length) {\n                                ayManagerEnv.refresh(placements);\n                            }\n                        }\n                        // don't increment on ad slide\n                        if (mutation.target.querySelector('.mpu-ad')) {\n                            skipBecauseOfAdSlide = true;\n                        } else {\n                            skipBecauseOfAdSlide = false;\n                            slideIndex++;\n                        }\n                    }\n                });\n            });\n            slideIndexObserver.observe(slideSelection, { attributeFilter: ['class'], subtree: true });\n        } else {\n            const royalSlider = overlayContainer.querySelector('.royalSlider');\n            if (royalSlider) {\n                const observer = new MutationObserver(function(mutations) {\n                    if (royalSlider.querySelector('.rsContainer')) {\n                        observer.disconnect();\n                        registerSlideIndexObserver(overlayContainer);\n                    }\n                });\n                observer.observe(royalSlider, { childList: true, subtree: true });\n            } else {\n                console.warn('No gallery slide container found.');\n            }\n        }\n    }\n    function registerObservers() {\n        // handle gallery overlay opening and closing\n        const overlayContainer = document.querySelector('#fullScreenGallery, .full-screen-gallery__container');\n        if (!overlayContainer) {\n            console.warn('No gallery container found.');\n            return;\n        }\n        let lastState = overlayContainer.style.display;\n        const observer = new MutationObserver(function(mutations) {\n            const display = overlayContainer.style.display;\n            if (lastState === display) return;\n            lastState = display;\n            if (display === 'none') {\n                const placements = getGalleryPlacements(overlayContainer);\n                if (placements.length) {\n                    ayManagerEnv.reset(placements);\n                }\n            } else if (display === 'block') {\n                ayManagerEnv.changePage();\n                registerSlideIndexObserver(overlayContainer);\n            }\n        });\n        observer.observe(overlayContainer, { attributeFilter: ['style'] });\n\n        // handle mobile gallery ad slide\n        const controls = overlayContainer.querySelector('.full-screen-gallery__controls');\n        if (controls) {\n            let lastControlsState = controls.style.display;\n            const observer = new MutationObserver(function(mutations) {\n                const display = controls.style.display;\n                if (lastControlsState === display) return;\n                lastControlsState = display;\n                if (display === 'none') {\n                    ayManagerEnv.changePage();\n                }\n            });\n            observer.observe(controls, { attributeFilter: ['style'] });\n        } else {\n            console.warn('No gallery controls found.');\n        }\n    }\n\n    if (document.readyState === 'loading') {\n        document.addEventListener('DOMContentLoaded', registerObservers, false);\n    } else {\n        registerObservers();\n    }\n})();\n</script>"},{"_id":"AAGStpLBhvPAnRBoC","name":"sizeMapping","conditions":[],"htmlCode":"<script>\n(function() {\n    var sizeAdditionMode = false;\n    var getSizeMapping = function(adUnitCode) {\n        if ('{{ aaN6kymj9s4zugqst }}' === 'Agnetha' && adUnitCode === 'mpu-3') {\