  Drupal.behaviors.CBPSubThemeAccordionExpandall = {
        attach: function(context, settings) {


                $('button.usa-accordion__control-all:not(.dhssubtheme-expand-all-processed)')
                  .addClass('dhssubtheme-expand-all-processed')
                  .click(function(event) {
                        if($(this).hasClass('accordion-close')) {
                            $(this).parent().parent().parent().find('.usa-accordion__button[aria-expanded="true"]').click();
                        } else {
                          // lock scroll position, but retain settings for later
                          var scrollPosition = [
                            self.pageXOffset || document.documentElement.scrollLeft || document.body.scrollLeft,
                            self.pageYOffset || document.documentElement.scrollTop  || document.body.scrollTop
                          ];
                          if(scrollPosition[0] == 0 && scrollPosition[1] == 0) {
                            scrollPosition[1] = 1;
                            window.scrollTo(0, 2);
                          }
                          var html = jQuery('html'); // it would make more sense to apply this to body, but IE7 won't have that
                          html.data('scroll-position', scrollPosition);
                          html.data('previous-overflow', html.css('overflow'));
                          html.css('overflow', 'hidden');
                          window.scrollTo(scrollPosition[0], scrollPosition[1]);

                          $(this).parent().parent().parent().find('.usa-accordion__button[aria-expanded="false"]').click();

                          // un-lock scroll position
                          var html = jQuery('html');
                          var scrollPosition = html.data('scroll-position');
                          html.css('overflow', html.data('previous-overflow'));
                          window.scrollTo(scrollPosition[0], scrollPosition[1])
                        }

                        return false;
                });
        }
    }


    Drupal.behaviors.CBPVideoPlayPause = {
          attach: function(context, settings) {
            $('.hero-video-play-pause-button').click(function(event) {
              var playing =  true;
              if(  $('.play-pause-wrapper .hero-video-play-pause-button').hasClass("playing-bg-videos")){
                playing =  true;
                $('.play-pause-wrapper .hero-video-play-pause-button').addClass("paused-bg-videos");
                $('.play-pause-wrapper .hero-video-play-pause-button').removeClass("playing-bg-videos");
              }else{
                playing =  false;
                $('.play-pause-wrapper .hero-video-play-pause-button').addClass("playing-bg-videos");
                $('.play-pause-wrapper .hero-video-play-pause-button').removeClass("paused-bg-videos");
              }

              $( 'video.background-video' ).each(function(index) {

                  var mediaVideo = $(this).get(0);
                   if (playing) {
                       mediaVideo.pause();
                   } else {
                       mediaVideo.play();
                   }
              });


            });

