$(document).ready(function(){$('#news a').click(function(){var thisColumn=$(this).closest('.column');if(thisColumn.attr('id')=='news-items'){if(typeof gtag!='undefined'){gtag('event','click',{'event_category':'Panel: News Item Click','link_url':$(this).attr('href'),'link_domain':this.hostname,'link_text':$.trim($(this).text())});}}
else if(thisColumn.attr('id')=='pe-items'){if(typeof gtag!='undefined'){gtag('event','click',{'event_category':'Panel: Public Engagemen Item Click','link_url':$(this).attr('href'),'link_domain':this.hostname,'link_text':$.trim($(this).text())});}}
else if(thisColumn.attr('id')=='itn-items'){if(typeof gtag!='undefined'){gtag('event','click',{'event_category':'Panel: In The News Item Click','link_url':$(this).attr('href'),'link_domain':this.hostname,'link_text':$.trim($(this).text())});}}});$('#news .column').autoHeight({perRow:true});$('#news #news-items ul > li a').autoHeight({minWidth:636,maxWidth:944});});