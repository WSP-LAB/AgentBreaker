PWT.HookForPrebidRequestBids = function (adUnits) {
    adUnits.forEach(function (au) {

      // --- Only block [800,45] for Cadent bidder ---
      if (au.bids && Array.isArray(au.bids)) {
        au.bids.forEach(function (bid) {
          if (bid.bidder === 'cadent_aperture_mx') {
            console.log('Removing 800x45 from Cadent:', au.code);

            if (au.mediaTypes && au.mediaTypes.banner &&
  au.mediaTypes.banner.sizes) {
              au.mediaTypes.banner.sizes =
  au.mediaTypes.banner.sizes.filter(function (s) {
                return !(s[0] === 800 && s[1] === 45);
              });
            }

            if (au.sizes) {
              au.sizes = au.sizes.filter(function (s) {
                return !(s[0] === 800 && s[1] === 45);
              });
            }
          }
        });
      }

    });
  };

  owpbjs.setConfig({
      "realTimeData": {
          "dataProviders": [{
              "name": 'timeout',
              "params": {
                  "rules": {
                      "includesVideo": {
                          "true": 100,
                          "false": 25
                      },
                      "numAdUnits": {
                          "1-3": 25,
                          "4-8": 100,
                          "9-15": 175
                      },
                      "deviceType": {
                          "2": 50,
                          "4": 75,
                          "5": 100
                      },
                      "connectionSpeed": {
                          "slow": 250,
                          "medium": 75,
                          "fast": -50,
                          "unknown": 125
                      }
                  }
              }
          }]
      },
      "bidderTimeout": 875,
  });

  if(Math.floor(Math.random() * 100) < 10){
      owpbjs.setConfig({testGroupId: 1});
      googletag.cmd.push(function () {
          googletag.pubads().setTargeting("OW_UPR", "true");
      });
  }
  else{
      owpbjs.setConfig({testGroupId: 0});
      googletag.cmd.push(function () {
          googletag.pubads().setTargeting("OW_UPR", "false");
      });
  };
//Custom code by publisher ends
