chatWrapper.invokeChatbot = function (evt, args) {
    chatWrapperConstants.windowDestroyedManually = true;
    this.toggleAgentOff();
    this.toggleChatbotOn(evt);
};
 
chatWrapper.invokeAgent = function (evt, args) {
    this.toggleAgentOn(evt, args);
    this.toggleChatbotOff();
    chatWrapperConstants.offlineFormSubmitted = false;
};
 
chatWrapper.toggleChatbotOn = function (payload) {
    this.chatbotVisible = true;
    const chatbotEvent = new CustomEvent(chatWrapper.EVENT_INVOKE_CHATBOT, { detail: payload });
    document.dispatchEvent(chatbotEvent);
};
 
chatWrapper.toggleChatbotOff = function () {
    this.chatbotVisible = false;
    const chatbotEvent = new CustomEvent(chatWrapper.EVENT_CLOSE_CHATBOT);
    document.dispatchEvent(chatbotEvent);
 
};

chatWrapper.notifiyAgentAvailable = function (isAgentAvailable) {
    chatWrapperConstants.agentAvailable = isAgentAvailable;
    const agentAvailableEvent = new CustomEvent(chatWrapper.EVENT_AGENT_AVAILABLE, {detail: {isAgentAvailable: isAgentAvailable } } );
    document.dispatchEvent(agentAvailableEvent);
};

chatWrapper.checkAvailability = function(){
    return new Promise((resolve, reject) => {
        resolve({agentAvailable: chatWrapperConstants.agentAvailable})
    });
}
 
chatWrapper.toggleAgentOn = function (evt, args) {
    this.agentVisible = true;
    chatWrapperConstants.chatRequested = true;

    resetEmbeddedServiceForNewChatSession();
    initializeChatWrapper(evt);
    displayLoadingWindow();
};
 
chatWrapper.toggleAgentOff = function () {
    this.agentVisible = false;
    // ISO-36272 - Set 2 minute timer
    setTimeout(()=> {
        embedded_svc.liveAgentAPI.endChat();
    }, 120000);
};
 
function initESW(gslbBaseURL, prechatData) {
 
    if (chatWrapperConstants.acceptedLanguages.includes(convertLanguageStringToCode(prechatData[chatWrapperConstants.mapping.LANGUAGE.jsonName]))) {
        chatWrapper.language = convertLanguageStringToCode(prechatData[chatWrapperConstants.mapping.LANGUAGE.jsonName]);
    }
 
    //Since we're reusing the same embedded service for successive chat sessions, we don't want to add our event handlers multiple times
    //But other settings and prechat data will change
    if(!chatWrapperConstants.handlersAdded){
        applyEmbeddedServiceHandlers();
        chatWrapperConstants.handlersAdded = true;
    }
 
    applyEmbeddedServiceSettings();
 
    applyPrechatFields(prechatData);
    
    embedded_svc.init(
        chatWrapper.environmentUrl,
        chatWrapper.environmentSiteUrl,
        gslbBaseURL,
        chatWrapper.orgId,
        chatWrapper.buttonName,
        {
            baseLiveAgentContentURL: chatWrapper.baseLiveAgentContentURL,
            deploymentId: chatWrapper.deploymentId,
            buttonId: chatWrapper[chatWrapper.language].chatButtonInstance,
            baseLiveAgentURL: chatWrapper.baseLiveAgentURL,
            eswLiveAgentDevName: chatWrapper.eswLiveAgentDevName,
            isOfflineSupportEnabled: getOfflineSupported()
        }
    );
};
 
 
