function convertLanguageStringToCode(languageString){
    if(languageString?.toLowerCase()?.trim() === 'spanish'){
        return 'es';
    }
    return 'en';
}

function resetEmbeddedServiceForNewChatSession(){
    //Reset the embedded_svc variable so that it can take on new properties for prechat data
    let storedJSON = JSON.parse(chatWrapperConstants.emptyEmbeddedService);
    Object.keys(embedded_svc).forEach(key => {
        if(storedJSON[key] !== undefined){
            embedded_svc[key] = storedJSON[key];
        }
    })
    //Need to add this because targetElement is getting stripped when converted to JSON
    embedded_svc.settings.targetElement = document.querySelector('body');
}
 
function addObserver() {
    const dockableContainer = document.querySelector('.dockableContainer');
    if (dockableContainer) {
        const observer = new MutationObserver((mutationList) => {
            renderSendButton();
            renderEndChatButton();
        });
 
        observer.observe(dockableContainer, {
            childList: true,
            subtree: true
        })
    }
}
 
function renderSendButton() {
    let existingSendButton = document.querySelector('#sendBtn');
 
    if (!existingSendButton) {
        console.log('sendButton does not exist!');
 
        let chasitorControls = document.querySelector('.chasitorControls');
 
        if (chasitorControls) {
            let submitBtn = document.createElement("button");
            submitBtn.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" fill="#09A761"/>
                </svg>
            `;
            submitBtn.id = 'sendBtn';
            submitBtn.addEventListener('click', buttonPressHandler);
            chasitorControls.appendChild(submitBtn);
        }
    } else{
        const fileUploadSendButton = document.querySelector('.fileUploadControls .chatActionButton:last-child');
 
        if(fileUploadSendButton){
            if (!existingSendButton.classList.contains('hidden')) {
                document.querySelector("#sendBtn").classList.add('hidden');
            }
        } else {
            document.querySelector("#sendBtn").classList.remove('hidden');
        }
    }
}
 
function renderEndChatButton() {
    let existingEndChatButton = document.querySelector('.endChatBtn');
 
    if (!existingEndChatButton) {
        let messageArea = document.querySelector('.messageArea');
 
        if (messageArea) {
            let endChatBtn = document.createElement("button");
            endChatBtn.innerHTML = `
                <Span>End Chat</Span>
            `;
            endChatBtn.classList.add('endChatBtn');
            endChatBtn.addEventListener("click", () => {
                let header = document.querySelector('.dockableContainer ');
                let closeButton = header.querySelector('.closeButton');
                              
                closeButton.click();
            })
            messageArea.insertAdjacentElement("beforebegin", endChatBtn);
 
            let header = document.querySelector('.dockableContainer ');
            let headerAnnouncement = header.querySelector('.headerAnnouncement');
            let closeButton = document.querySelector('.endChatBtn')
 
            headerAnnouncement.insertAdjacentElement("beforebegin", closeButton);
        }
    }
}
 
function buttonPressHandler() {
    // create a new keyboard event and set the key to "Enter"
    const event = new KeyboardEvent('keydown', {
        key: 'Enter',
        code: 'Enter',
        which: 13,
        keyCode: 13,
    });
 
    // dispatch the event on some DOM element
    var chasitorText = document.querySelector('.chasitorText');
    chasitorText.dispatchEvent(event);
}
 
