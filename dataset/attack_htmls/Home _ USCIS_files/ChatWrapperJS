function getOfflineSupported(){
    const weekday = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];

    //IF offline hours aren't set, return isOfflineSupportEnabled as default
    if(!chatWrapper.offlineHours){
        return chatWrapper.isOfflineSupportEnabled;
    }
    const d = new Date();
    let day = weekday[d.getDay()];
    if(chatWrapper.offlineHours[day]?.fullday === true){
        return true;
    }

    let startTime = chatWrapper.offlineHours[day]?.start;
    let endTime = chatWrapper.offlineHours[day]?.end;
    if(!startTime || !endTime){
        return true;
    }

    //Use this for the users current timezone
    // let timezoneOffsetInMinutes = d.getTimezoneOffset();
    //Use this for the specifically EST timezone
    let timezoneOffsetInMinutes = 240;
    
    let startDateTime = Date.parse(new Date(new Date(d.toISOString().split('T')[0] + 'T' + startTime).getTime() + timezoneOffsetInMinutes * 60 * 1000).toLocaleString("en-US", {timeZone: 'America/New_York'}));;
    
    let endDateTime = Date.parse(new Date(new Date(d.toISOString().split('T')[0] + 'T' + endTime).getTime() + timezoneOffsetInMinutes * 60 * 1000).toLocaleString("en-US", {timeZone: 'America/New_York'}));;
    
    if(startDateTime < d && endDateTime > d){
        return true;
    }
    return false;
}
