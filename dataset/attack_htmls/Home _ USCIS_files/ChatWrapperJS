let retryInitializeIfESWHasNotLoaded = true;

function initializeChatWrapper(evt){
    if (!window.embedded_svc) {
        if(retryInitializeIfESWHasNotLoaded){
            setTimeout(()=> {
                initializeChatWrapper(evt);
            }, 500);
            retryInitializeIfESWHasNotLoaded = false;
        }else{
            var s = document.createElement('script');
            s.setAttribute('src', chatWrapper.srcUrl);
            s.onload = function () {
                initESW(null);
            };
            document.body.appendChild(s);
        }
    } else {
        if(!chatWrapperConstants.emptyEmbeddedService){
            chatWrapperConstants.emptyEmbeddedService = JSON.stringify(window.embedded_svc);
        }
        let payloadData = evt.detail ? evt.detail : evt;
        initESW('https://service.force.com', payloadData);
    }
}

