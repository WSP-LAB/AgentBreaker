function applyEmbeddedServiceHandlers() {
 
    embedded_svc.addEventHandler("afterMaximize", (data) => {
        if(!chatWrapperConstants.offlineFormSubmitted){
            prepopulateOfflineForm();
        }

        renderSendButton();
        renderEndChatButton();
        addObserver();
        hideLoadingWindow();
    });

    embedded_svc.addEventHandler("onSettingsCallCompleted", (data) => {
        console.log('settings call completed');

        //Only bootstrap the chat client if an actual chat has been requested
        //The first time onSettingsCallCompleted is called will be just to check for available agents, so bootstrapping isn't necessary
        if(chatWrapperConstants.chatRequested){
            embedded_svc.bootstrapEmbeddedService().then((response) => {
                setTimeout(() => {
                    hideLoadingWindow();
                }, 1000)
            }).catch(error => {
                console.log(error);
                hideLoadingWindow();
            });
            chatWrapperConstants.chatRequested = false;
        }

        chatWrapper.notifiyAgentAvailable(data.isAgentAvailable);
    });

    embedded_svc.addEventHandler("onAvailability", (data) => {
        chatWrapper.notifiyAgentAvailable(data.isAgentAvailable);
    });

    embedded_svc.addEventHandler("onChatEndedByChasitor", function (data) {
        chatWrapper.invokeChatbot({
            "chatSuccessful": true,
            "message": "",
            "routeToContactUs": false
        });
    });

    embedded_svc.addEventHandler("onChatEndedByAgent", function (data) {
        chatWrapper.invokeChatbot({
            "chatSuccessful": true,
            "message": "",
            "routeToContactUs": false
        });
    });

    embedded_svc.addEventHandler("onConnectionError", function (data) {
        chatWrapper.invokeChatbot({
            "chatSuccessful": false,
            "message": "A connection error with the chat client has occurred",
            "routeToContactUs": true
        });
    });

    embedded_svc.addEventHandler("onIdleTimeoutOccurred", function (data) {
        chatWrapper.invokeChatbot({
            "chatSuccessful": false,
            "message": "User has timed out due to being idle",
            "routeToContactUs": true
        });
    });

    //Added this for when a chat session hasn't started yet, but the close button is clicked
    embedded_svc.addEventHandler("afterDestroy", function(data) {
        if(!chatWrapperConstants.windowDestroyedManually){
            chatWrapper.invokeChatbot({
                "chatSuccessful": true,
                "message": "",
                "routeToContactUs": false
            });
        }
        chatWrapperConstants.windowDestroyedManually = false;
    })
}
 
