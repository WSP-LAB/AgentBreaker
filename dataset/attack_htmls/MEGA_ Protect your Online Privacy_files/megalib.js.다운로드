class MegaFlags {
    static async get(key = undefined) {
        await this._ensureInit();

        const flags = { ...this._flags, ...this._getLocalFlags() }; // Shallow, for now

        if (key !== undefined) {
            return flags[key] || null;
        }

        return flags;
    }

    static set(key, value) {
        const flags = this._getLocalFlags();

        if (key && value !== undefined) {
            flags[key] = value;
            Storage.local.setItem('d.flags', JSON.stringify(flags));
        }
        else if (key) {
            delete flags[key];
            Storage.local.setItem('d.flags', JSON.stringify(flags));
        }
        else {
            Storage.local.removeItem('d.flags');
        }
    }

    static _getLocalFlags() {
        let localFlags = Storage.local.getItem('d.flags');
        if (!localFlags) return { };

        try {
            localFlags = JSON.parse(localFlags);
        }
        catch (e) {
            console.error("Couldn't parse local flags.");
            console.trace(e, localFlags);
            return { };
        }

        return localFlags;
    }

    static async _fetchFlags() {
        this._fetchPromise = this._fetchPromise || Api.request({ a: 'gmf' });

        let response;
        try {
            response = await this._fetchPromise;
        }
        catch (e) {
            console.error('Couldn\'t request MEGA flags from API.', e.message);
            return null;
        }
        finally {
            this._fetchPromise = null;
        }

        if (typeof response !== 'object') {
            console.error('Unexpected response from API when fetching MEGA flags.',
                Number.isInteger(response) ? `${response} ${ApiErrors.getMessage(response)}` : '');
            return null;
        }

        return response;
    }

    static async _ensureInit() {
        if (!this._flags) {
            this._flags = (await this._fetchFlags()) || { };
        }
    }
}

class MioButtonUtils {
    static initEventLoggingOnAll() {
        document.addEventListener('DOMContentLoaded', () => {
            const mioButtons = document.body.querySelectorAll('button.button, a.button');
            for (const button of mioButtons)
            {
                MioButtonUtils.initEventLogging(button);
            }
        });
    }

    /**
     * Log click events for the given button to the API for stats.
     * Accepts button and anchor elements.
     *
     * @param {HTMLButtonElement|HTMLAnchorElement} button
     */
    static initEventLogging(button) {
        if (!button) return;

        const logId = parseInt(button.dataset.logId);
        if (!logId) return;

        if (button instanceof HTMLButtonElement) {
            button.addEventListener('click', async () => await Api.log(logId));
        }
        else if (button instanceof HTMLAnchorElement) {
            button.addEventListener('click', async (e) => {
                e.preventDefault();

                const newTabAndTrusted = button.target === '_blank' && e.isTrusted;

                if (newTabAndTrusted) {
                    window.open(button.href, '_blank', 'noopener');
                }

                await Api.log(logId);

                if (!newTabAndTrusted) {
                    await Utils.sleep(10); // sanity; give browser time to update request status in dev tools

                    window.location.href = button.href;
                }
            });
        }
    }

    static setStyle(button, style) {
        const buttonStyles = [
            'primary', 'secondary', 'outline',
            'primary-muted', 'secondary-muted', 'outline-muted',
        ];

        if (!buttonStyles.includes(style)) {
            console.warn(`MioButtonUtils: Unexpected style "${style}. Not updating button style."`);
            return;
        }

        button.classList.remove(...buttonStyles);
        button.classList.add(style);
    }
}

