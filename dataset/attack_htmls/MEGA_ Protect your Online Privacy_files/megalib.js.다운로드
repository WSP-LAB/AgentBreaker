                return await Formatter.formatLocalCurrency(lowestPrice);
            },
        },
        {
            key: 'pwmPriceLowest',
            _fetchValue: async () => {
                const plans = await Plans.instance.getAll();
                const vpnPlans = plans.filter((plan) => plan instanceof FeaturePlan && plan.features.pwm);

                let lowestPrice = Number.NaN;
                for (const plan of vpnPlans) {
                    const monthly = plan.localPriceNet / plan.months;
                    lowestPrice = (Number.isNaN(lowestPrice) || monthly < lowestPrice) ? monthly : lowestPrice;
